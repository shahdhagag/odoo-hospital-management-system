<odoo>

    <!-- Department Tree View -->
    <record id="department_tree_view" model="ir.ui.view">
        <field name="name">hms.department.tree</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="is_opened"/>
            </tree>
        </field>
    </record>


    <!-- Department Form View -->
    <record id="department_form_view" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="is_opened"/>
                    </group>

                    <group>
                        <field name="patient_ids">
                            <tree>
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="age"/>
                            </tree>
                        </field>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Department Action -->
    <record id="department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- Department Menu -->
    <menuitem
        id="department_menu"
        name="Departments"
        parent="hms_root_menu"
        action="department_action"
    />

</odoo>