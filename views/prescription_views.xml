<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="prescription_tree_view" model="ir.ui.view">
            <field name="name">hms.prescription.tree</field>
            <field name="model">hms.prescription</field>
            <field name="arch" type="xml">
                <tree string="Prescriptions"
                      decoration-success="state == 'confirmed'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="encounter_id"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="prescription_date"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="prescription_form_view" model="ir.ui.view">
            <field name="name">hms.prescription.form</field>
            <field name="model">hms.prescription</field>
            <field name="arch" type="xml">
                <form string="Prescription">
                    <header>
                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_cancel"
        string="Cancel"
        type="object"
        attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Encounter Information">
                                <field name="encounter_id"
                                       domain="[('state', '=', 'in_progress')]"
                                       attrs="{'readonly': [('name', '!=', 'New')]}"/>
                                <field name="patient_id" readonly="1"/>
                                <field name="doctor_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="prescription_date"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medications">
                                <field name="line_ids"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}">
                                    <tree editable="bottom">
                                        <field name="medication_name"/>
                                        <field name="dosage"/>
                                        <field name="frequency"/>
                                        <field name="duration"/>
                                        <field name="duration_unit"/>
                                        <field name="instructions"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="prescription_search_view" model="ir.ui.view">
            <field name="name">hms.prescription.search</field>
            <field name="model">hms.prescription</field>
            <field name="arch" type="xml">
                <search string="Search Prescriptions">
                    <field name="name"/>
                    <field name="encounter_id"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <filter name="draft" string="Draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Confirmed"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter name="cancelled" string="Cancelled"
                            domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_patient" string="Patient"
                                context="{'group_by': 'patient_id'}"/>
                        <filter name="group_doctor" string="Doctor"
                                context="{'group_by': 'doctor_id'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="prescription_action" model="ir.actions.act_window">
            <field name="name">Prescriptions</field>
            <field name="res_model">hms.prescription</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="prescription_search_view"/>
        </record>

        <menuitem id="hms_prescription_menu"
                  name="Prescriptions"
                  parent="hms_root_menu"
                  action="prescription_action"
                  sequence="40"
                  groups="hms.group_hms_user"/>

    </data>
</odoo>
