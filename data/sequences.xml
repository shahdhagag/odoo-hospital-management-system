<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Patient Sequence -->
        <record id="seq_hms_patient" model="ir.sequence">
            <field name="name">Patient Medical Record</field>
            <field name="code">hms.patient</field>
            <field name="prefix">PAT</field>
            <field name="padding">5</field>
            <field name="number_next">24</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Appointment Sequence -->
        <record id="seq_hms_appointment" model="ir.sequence">
            <field name="name">Hospital Appointment</field>
            <field name="code">hms.appointment</field>
            <field name="prefix">APT</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Medical Encounter Sequence -->
<record id="seq_hms_medical_encounter" model="ir.sequence">
    <field name="name">Medical Encounter</field>
    <field name="code">hms.medical.encounter</field>
    <field name="prefix">ENC</field>
    <field name="padding">5</field>
    <field name="number_next">1</field>
    <field name="number_increment">1</field>
</record>

        <!-- Prescription Sequence -->
        <record id="seq_hms_prescription" model="ir.sequence">
            <field name="name">Medical Prescription</field>
            <field name="code">hms.prescription</field>
            <field name="prefix">PRE</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>